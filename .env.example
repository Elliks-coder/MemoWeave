# Hy-Memory Ultra 推荐配置：DeepSeek V4 Flash + 阿里云百炼 qwen3.7-text-embedding
# 复制为 .env 后填写真实密钥。不要把 .env 提交到 Git。

# ---------- LLM：记忆抽取、合并、反思与 System 2 ----------
MEMORY_LLM_PROVIDER=openai
MEMORY_LLM_MODEL=deepseek-v4-flash
MEMORY_LLM_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
MEMORY_LLM_BASE_URL=https://api.deepseek.com
MEMORY_LLM_TEMPERATURE=0.1
MEMORY_LLM_MAX_TOKENS=2048
MEMORY_AGENT_MAX_TOKENS=4096
MEMORY_LLM_TIMEOUT=180
MEMORY_LLM_MAX_RETRIES=3

# ---------- Embedding：阿里云百炼 OpenAI 兼容接口 ----------
# 将 YOUR_WORKSPACE_ID 替换为百炼业务空间 ID；API Key 必须属于同一地域。
# 如果你的控制台给出了不同地址，以控制台/官方文档为准。
MEMORY_EMBEDDER_PROVIDER=openai
MEMORY_EMBEDDER_MODEL=qwen3.7-text-embedding
MEMORY_EMBEDDER_API_KEY=REPLACE_WITH_DASHSCOPE_API_KEY
MEMORY_EMBEDDER_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MEMORY_EMBEDDING_DIMS=1024
MEMORY_EMBEDDER_TIMEOUT=30
MEMORY_EMBEDDER_MAX_RETRIES=3

# ---------- 本地存储：无需额外服务 ----------
MEMORY_VECTOR_STORE=chroma
MEMORY_COLLECTION_NAME=hy_memory_ultra
MEMORY_DATA_DIR=D:/hy-memory/.runtime/ultra
MEMORY_PERSIST_DIR=D:/hy-memory/.runtime/ultra/chroma
MEMORY_GRAPH_PROVIDER=kuzu
MEMORY_GRAPH_DB_PATH=D:/hy-memory/.runtime/ultra/kuzu
MEMORY_CACHE_BACKEND=sqlite

# ---------- Entity-Fact GraphRAG（第一阶段建议先 shadow） ----------
# enabled=true：从 L1 提取候选关系，经 reconcile 后的 L2 发布到图。
# shadow=true：执行并记录图扩展，但暂不把图证据加入回答上下文。
MEMORY_GRAPHRAG_ENABLED=false
MEMORY_GRAPHRAG_SHADOW_MODE=true
MEMORY_GRAPHRAG_MAX_HOPS=2
MEMORY_GRAPHRAG_MAX_FACTS=5
MEMORY_GRAPHRAG_MAX_DEGREE=25
MEMORY_GRAPHRAG_MIN_CONFIDENCE=0.8

# ---------- 处理与观测 ----------
MEMORY_MODE=ultra
MEMORY_ENABLE_SUMMARY=false
MEMORY_FEW_SHOT_ENABLED=false
MEMORY_LOG_LEVEL=INFO

# 本地 Embedding 备选（需先安装 Ollama 并执行：ollama pull bge-m3）：
# MEMORY_EMBEDDER_MODEL=bge-m3
# MEMORY_EMBEDDER_API_KEY=ollama
# MEMORY_EMBEDDER_BASE_URL=http://127.0.0.1:11434/v1
# MEMORY_EMBEDDING_DIMS=1024
